# GuideLLM 성능 평가 기본 설정. 환경변수로 덮어쓸 수 있다 (예: MAX_SECONDS=60 ./run.sh)
# 우선순위: 환경변수 > scenarios.yaml 의 시나리오별 값 > 이 파일

# --- 부하 ---
MAX_SECONDS=${MAX_SECONDS:-30}       # 시나리오당 측정 시간(초). 테스트 환경은 30~60 권장
WARMUP=${WARMUP:-5}                  # 앞부분 N초를 결과에서 제외 (워밍업). %가 아니라 초 단위 (adapter v0.5.0 은 "10%" 를 10초로 처리)
MAX_REQUESTS=${MAX_REQUESTS:-}       # 값을 주면 요청 수로 제한 (시간보다 먼저 끝날 수 있음)
RATE_SCALE=${RATE_SCALE:-1}          # 시나리오 동시 사용자(rate)에 곱하는 배수. 0.5 = 절반 부하
SCENARIOS=${SCENARIOS:-all}          # 실행할 시나리오 (쉼표 구분) 또는 all

# --- 대상 모델 ---
# EvalHub job sidecar 는 모델 프록시에서 OpenShift service CA 를 신뢰하지 않으므로
# KServe 의 vLLM 직접 포트(<isvc>-metrics:8080)를 쓴다. (kube-rbac-proxy 미경유 → 수치가 약간 낙관적)
MODEL_URL=${MODEL_URL:-http://qwen3-4b-instruct-2507-v10-metrics.model-hub.svc.cluster.local:8080/v1}
MODEL_NAME=${MODEL_NAME:-qwen3-4b-instruct-2507-v10}
# 합성 데이터 토큰 길이를 맞추기 위한 tokenizer. 폐쇄망이면 S3 에 올리고 /test_data/tokenizer 사용
PROCESSOR=${PROCESSOR:-Qwen/Qwen3-4B-Instruct-2507}

# --- EvalHub ---
TENANT=${TENANT:-kbl-eval}
PROVIDER_NAME=${PROVIDER_NAME:-kbl_perf}
EXPERIMENT=${EXPERIMENT:-kbl-qwen3-4b-perf}
