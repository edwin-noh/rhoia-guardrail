# GuideLLM 성능 평가 기본 설정. 환경변수로 덮어쓸 수 있다 (예: MAX_SECONDS=60 ./run.sh)
# 우선순위: 환경변수 > scenarios.yaml 의 시나리오별 값 > 이 파일

# --- 부하 ---
MAX_SECONDS=${MAX_SECONDS:-30}       # 시나리오당 측정 시간(초). 테스트 환경은 30~60 권장
WARMUP=${WARMUP:-5}                  # 앞부분 N초를 결과에서 제외 (워밍업). %가 아니라 초 단위 (adapter 는 "10%" 를 10초로 처리)
MAX_REQUESTS=${MAX_REQUESTS:-}       # 값을 주면 요청 수로 제한 (시간보다 먼저 끝날 수 있음)
RATE_SCALE=${RATE_SCALE:-1}          # 시나리오 동시 사용자(rate)에 곱하는 배수. 0.5 = 절반 부하
SCENARIOS=${SCENARIOS:-all}          # 실행할 시나리오 (쉼표 구분) 또는 all

# --- 대상 모델 ---
# 대상 정의(URL, 인증 Secret, tokenizer, experiment)는 targets.yaml 에 있다.
TARGETS=${TARGETS:-all}              # 실행할 대상 (쉼표 구분: raw,maas) 또는 all

# --- 결과 / 모니터링 ---
MLFLOW_URL=${MLFLOW_URL:-https://rh-ai.apps.rhoai-35.edwin.home/mlflow}   # 리포트가 benchmarks.json(p50/p95)을 받는 곳
GRAFANA_URL=${GRAFANA_URL:-https://grafana-route-grafana.apps.rhoai-35.edwin.home}

# --- EvalHub ---
TENANT=${TENANT:-kbl-eval}
PROVIDER_NAME=${PROVIDER_NAME:-kbl_perf}
